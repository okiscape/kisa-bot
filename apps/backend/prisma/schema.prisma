generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserSettings {
  userId      BigInt  @id @map("user_id")
  timezone    String? @db.Text
  osuUsername  String? @map("osu_username") @db.Text

  @@map("user_settings")
}

model UserProfile {
  userId       BigInt   @id @map("user_id")
  aboutMe      String?  @map("about_me") @db.Text
  color        String?  @db.Text
  customImage  String?  @map("custom_image") @db.Text

  @@map("user_profiles")
}

model ServerSettings {
  guildId             BigInt   @id @map("guild_id")
  averageLanguage     String?  @map("average_language") @db.Text
  badWords            String?  @map("bad_words") @db.Text
  notifiedModerators  String?  @map("notified_moderators") @db.Text
  notifyChannel       BigInt?  @map("notify_channel")
  badWordsAction      String?  @map("bad_words_action") @db.Text
  joinChannel         BigInt?  @map("join_channel")
  leaveChannel        BigInt?  @map("leave_channel")
  postChannel         BigInt?  @map("post_channel")
  muteRole            BigInt?  @map("mute_role")
  autoRole            BigInt?  @map("auto_role")
  logChannel          BigInt?  @map("log_channel")
  verifiedRole        BigInt?  @map("verified_role")
  ticketCategory      BigInt?  @map("ticket_category")
  fareText            String?  @map("fare_text") @db.Text
  fareColor           String?  @map("fare_color") @db.Text
  fareImage           String?  @map("fare_image") @db.Text
  greetText           String?  @map("greet_text") @db.Text
  greetColor          String?  @map("greet_color") @db.Text
  greetImage          String?  @map("greet_image") @db.Text
  privateCrChannel    BigInt?  @map("private_cr_channel")
  privateCategory     BigInt?  @map("private_category")
  customGreet         String?  @map("custom_greet") @db.Text
  customFare          String?  @map("custom_fare") @db.Text
  notifyText          String?  @map("notify_text") @db.Text
  collectMetrics      Boolean? @map("collect_metrics")
  greetingConfig      Json?    @map("greeting_config")
  farewellConfig      Json?    @map("farewell_config")
  loggingConfig       Json?    @map("logging_config")
  honeypotChannel     BigInt?  @map("honeypot_channel")
  reactionRoles       Json?    @map("reaction_roles")

  @@map("server_settings")
}

model SocialRating {
  userId  BigInt @id @map("user_id")
  rating  Int    @default(0)

  @@map("social_rating")
}

model Serververse {
  id          Int    @id @default(autoincrement())
  guildId1    BigInt @map("guild_id1")
  channelId1  BigInt @map("channel_id1")
  guildId2    BigInt @map("guild_id2")
  channelId2  BigInt @map("channel_id2")

  @@unique([guildId1, channelId1, guildId2, channelId2])
  @@map("serververse")
}

/// Bot-owned singleton metrics snapshot. Backend is read-only.
model BotMetrics {
  id             Int      @id
  guildCount     Int      @default(0) @map("guild_count")
  userCount      Int      @default(0) @map("user_count")
  commandCount   Int      @default(0) @map("command_count")
  usedCommands   Int      @default(0) @map("used_commands")
  channelCount   Int      @default(0) @map("channel_count")
  shardCount     Int      @default(0) @map("shard_count")
  latencyMs      Int      @default(0) @map("latency_ms")
  uptimeSeconds  Int      @default(0) @map("uptime_seconds")
  version        String   @default("") @db.Text
  online         Boolean  @default(false)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("bot_metrics")
}

/// Backend-owned opaque web sessions. Discord tokens are encrypted at rest.
model WebSession {
  id                     String    @id @db.Text
  userId                 BigInt    @map("user_id")
  accessTokenEncrypted   String    @map("access_token_encrypted") @db.Text
  refreshTokenEncrypted  String?   @map("refresh_token_encrypted") @db.Text
  accessTokenExpiresAt   DateTime  @map("access_token_expires_at")
  refreshTokenExpiresAt  DateTime? @map("refresh_token_expires_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  lastUsedAt             DateTime  @default(now()) @map("last_used_at")
  expiresAt              DateTime  @map("expires_at")
  revokedAt              DateTime? @map("revoked_at")
  userAgentHash          String?   @map("user_agent_hash") @db.Text
  ipHash                 String?   @map("ip_hash") @db.Text

  @@index([userId])
  @@index([expiresAt])
  @@map("web_sessions")
}
